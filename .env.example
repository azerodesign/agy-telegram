# Telegram Bot Token dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# ID Pengguna Telegram yang diizinkan (pisahkan dengan koma jika lebih dari satu)
# Contoh: 12345678,87654321
# Jika dikosongkan, bot akan memberi tahu ID Anda saat pertama kali chat
ALLOWED_USERS=""

# ID Topic Telegram yang diizinkan (opsional jika bot dimasukkan ke group forum ber-topik)
# Contoh: ALLOWED_TOPICS="19"
ALLOWED_TOPICS=""

# Path ke binary agy
AGY_PATH="/home/ubuntu/.local/bin/agy"

# Default Working Directory saat mengeksekusi perintah
DEFAULT_WORKING_DIR="/home/ubuntu"
